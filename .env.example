# Every variable the server reads. Anything else starting with SHH_ makes
# startup fail, so typos are caught. Sizes are in bytes. See SPEC.md §7.

# local or production. Debug is refused in production.
SHH_ENV=local
SHH_DEBUG=true

# Public address of the site: scheme and host only.
SHH_URL=http://localhost:3000

# Where the API is served: path (SHH_URL/api) or subdomain (api.<host>).
# Ignored when SHH_ENV=local, which always uses path.
SHH_API_ROUTING=path

# Where the admin panel is served: path (SHH_URL/<locale>/admin, default) or subdomain
# (admin.<host>/<locale>/, which is easy to firewall). Ignored when SHH_ENV=local.
SHH_ADMIN_ROUTING=path

# What else is served: full (the built-in website, default) or api (API, admin panel and
# /static/* only; every other page is 404, for a frontend of your own).
SHH_WEB=full

# Random secret, different for every install. Generate with:
#   openssl rand -base64 32
# Signs admin sessions and CSRF tokens. Nothing about secrets depends on it.
SHH_SECRET_KEY=

# Bind address. 127.0.0.1 behind a reverse proxy on the same host; 0.0.0.0 in a
# container.
SHH_HOST=127.0.0.1
SHH_PORT=3000

# error (default), warn, info, debug or trace. Requests and IPs are never logged.
SHH_LOG_LEVEL=error

# Languages to offer, comma-separated. Available: en, de. Unset offers all.
#SHH_LOCALES=en,de

# Where visitors land whose browser asks for none of the offered languages.
# Must be one of SHH_LOCALES; unset means the first offered.
#SHH_DEFAULT_LOCALE=en

# Comma-separated addresses or ranges (10.0.0.1, 172.16.0.0/12) of reverse
# proxies whose X-Forwarded-For header we trust.
# Leave empty when not behind a proxy. 0.0.0.0 and :: are refused.
SHH_TRUSTED_PROXIES=

# sqlite or postgres; required, there is no default.
SHH_DB=sqlite

SHH_SQLITE_PATH=storage/shhnote.db

SHH_PG_HOST=127.0.0.1
SHH_PG_PORT=5432
SHH_PG_DATABASE=shhnote
SHH_PG_USERNAME=
SHH_PG_PASSWORD=

# Where encrypted blobs above SHH_INLINE_MAX go.
#   inline: nowhere; larger secrets are refused
#   local:  local disk
#   s3:     S3 or an S3-compatible service (MinIO, R2); bucket versioning must be off
# Variables for a tier that is not enabled make startup fail.
SHH_STORAGE=inline

# Largest padded blob kept in the database (default 2 MiB, 64 KiB to 64 MiB).
SHH_INLINE_MAX=2097152

# Largest padded blob the external tier accepts (default 64 MiB, at most 4 GiB).
# Only valid when SHH_STORAGE is local or s3.
#SHH_EXTERNAL_MAX_OBJECT=67108864

# Uploads in flight at once; further creates get 503 until one finishes (default 64).
#SHH_MAX_UPLOADS=64

# Local tier. The total ceiling is required: when reached, large secrets are
# refused while small ones keep working.
#SHH_LOCAL_PATH=storage/blobs
#SHH_LOCAL_MAX_TOTAL_BYTES=

# S3 tier. Leave SHH_S3_ENDPOINT empty for AWS; set it for S3-compatible
# services (scheme and host only, e.g. http://127.0.0.1:9000). The total
# ceiling is the cost breaker and is required.
#SHH_S3_BUCKET=
#SHH_S3_REGION=
#SHH_S3_ENDPOINT=
#SHH_S3_ACCESS_KEY_ID=
#SHH_S3_SECRET_ACCESS_KEY=
#SHH_S3_MAX_TOTAL_BYTES=
# Where uploads wait before going to the bucket (default storage/spool).
#SHH_SPOOL_PATH=

# Bootstrap credential for the admin panel (at least 32 characters). Only
# accepted until the first admin API key exists; unset it after that.
#SHH_ADMIN_TOKEN=
