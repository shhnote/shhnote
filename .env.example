APP_NAME=shhnote
APP_ENV=local
APP_DEBUG=true

# sqlite or postgres
DB_CONNECTION=postgres

SQLITE_PATH=storage/shhnote.db

PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=shhnote
PG_USERNAME=
PG_PASSWORD=

# local or s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/uploads

# Only needed when STORAGE_DRIVER=s3. Leave S3_ENDPOINT empty for AWS;
# set it for S3-compatible services like MinIO or Cloudflare R2.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
