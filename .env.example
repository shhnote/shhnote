# local or production. Never enable APP_DEBUG in production.
APP_ENV=local
APP_DEBUG=true

# Public address of the site, used for links, redirects and CSRF origin checks.
APP_URL=http://localhost:3000

# Where the API is served: path (APP_URL/api) or subdomain (api.<APP_URL host>).
# Versions are always in the path, e.g. /api/v1 or api.example.com/v1.
# Ignored when APP_ENV=local, which always uses path.
API_ROUTING=path

# Random secrets, different for every install. Generate each with:
#   openssl rand -base64 32
# APP_SECRET_KEY signs sessions and CSRF tokens. APP_ENCRYPTION_KEY encrypts
# stored data; losing it makes that data unreadable, so back it up separately
# from the database.
APP_SECRET_KEY=
APP_ENCRYPTION_KEY=

SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# error, warn, info, debug or trace
LOG_LEVEL=info

# Comma-separated IPs of reverse proxies whose X-Forwarded-For header we trust.
# Leave empty when not behind a proxy.
TRUSTED_PROXIES=

# sqlite or postgres
DB_CONNECTION=postgres

SQLITE_PATH=storage/shhnote.db

PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=shhnote
PG_USERNAME=
PG_PASSWORD=

# Where uploads are stored. Small files always go in the database (inline).
#   inline: database only
#   local:  database, with larger files on local disk
#   s3:     database, with larger files in S3
STORAGE_DRIVER=inline
STORAGE_LOCAL_PATH=storage/uploads

# Only needed when STORAGE_DRIVER=s3. Leave S3_ENDPOINT empty for AWS;
# set it for S3-compatible services like MinIO or Cloudflare R2.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Upload size limits, in bytes. Files up to the inline limit are stored in the
# database; larger ones go to local disk or S3, up to that backend's limit.
# The inline limit can be lowered but not raised above 1.5 MiB (1572864),
# to keep the database fast. The local and S3 limits must be at least the
# inline limit. Defaults: inline 1.5 MiB, local 10 MiB, S3 25 MiB.
UPLOAD_MAX_INLINE_BYTES=1572864
UPLOAD_MAX_LOCAL_BYTES=10485760
UPLOAD_MAX_S3_BYTES=26214400
