# /etc/shhnote/env: read by the systemd unit. Keep it mode 0640; it holds credentials.
# Paths are relative to /var/lib/shhnote.

SHH_ENV=production
SHH_URL=https://secrets.example.com

# Bind locally; the reverse proxy on this host terminates TLS.
SHH_HOST=127.0.0.1
SHH_PORT=3000
SHH_TRUSTED_PROXIES=127.0.0.1,::1

# Random, at least 32 characters. `openssl rand -base64 48`
SHH_SECRET_KEY=

# Bootstrap credential for the admin panel, at least 32 characters. Remove it once the
# first admin API key exists.
SHH_ADMIN_TOKEN=

# sqlite (default) or postgres.
SHH_DB=sqlite
#SHH_DB=postgres
#SHH_PG_HOST=127.0.0.1
#SHH_PG_PORT=5432
#SHH_PG_DATABASE=shhnote
#SHH_PG_USERNAME=shhnote
#SHH_PG_PASSWORD=

# Blobs above SHH_INLINE_MAX: inline (refuse), local or s3.
SHH_STORAGE=inline
#SHH_STORAGE=local
#SHH_LOCAL_MAX_TOTAL_BYTES=10737418240

SHH_LOG_LEVEL=warn
#SHH_LOCALES=en,de
#SHH_DEFAULT_LOCALE=en
