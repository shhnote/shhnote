# Install: copy the binary to /usr/local/bin/shhnote, the environment file to
# /etc/shhnote/env (mode 0640, root:shhnote is not needed thanks to DynamicUser), then
#   systemctl enable --now shhnote
# State lives in /var/lib/shhnote; relative paths in the environment file resolve there.
[Unit]
Description=shhnote zero-knowledge secret sharing
Documentation=https://github.com/shhnote/shhnote
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/shhnote check
ExecStart=/usr/local/bin/shhnote
EnvironmentFile=/etc/shhnote/env
WorkingDirectory=/var/lib/shhnote
StateDirectory=shhnote
StateDirectoryMode=0700
DynamicUser=yes
Restart=on-failure
RestartSec=5s
# Longer than the server's own 30 s drain, so an upload in progress can finish.
KillSignal=SIGTERM
TimeoutStopSec=35s

# Hardening: the process needs the network, its state directory and nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Only the proxy on this host talks to it, and SQLite needs no network at all. Add the
# database or object-store hosts here when SHH_DB=postgres or SHH_STORAGE=s3 points
# elsewhere (IPAddressAllow=10.0.0.5, or a range).
IPAddressDeny=any
IPAddressAllow=localhost
# Footprint: a few tokio threads, SHH_MAX_UPLOADS uploads of at most SHH_INLINE_MAX each,
# and one file descriptor per connection.
TasksMax=256
MemoryMax=1G
LimitNOFILE=65536
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
