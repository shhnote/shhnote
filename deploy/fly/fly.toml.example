# Copy to fly.toml in the repository root and set `app` and `primary_region`.
# One Fly app is one shhnote instance; for several regions create several apps and link
# them through the `regions` setting in each admin panel.
#
#   fly launch --no-deploy --copy-config
#   fly volumes create shhnote_data --size 10
#   fly secrets set SHH_SECRET_KEY=... SHH_ADMIN_TOKEN=...
#   fly deploy

app = "shhnote"
primary_region = "ams"
kill_signal = "SIGTERM"
kill_timeout = 35

[build]
  dockerfile = "Dockerfile"

[env]
  SHH_ENV = "production"
  SHH_URL = "https://shhnote.fly.dev"
  SHH_HOST = "0.0.0.0"
  SHH_PORT = "3000"
  SHH_DB = "sqlite"
  SHH_STORAGE = "inline"
  SHH_LOG_LEVEL = "warn"
  # Fly's proxy sets X-Forwarded-For from its own addresses.
  SHH_TRUSTED_PROXIES = "172.16.0.0/16,fdaa::/16"

[mounts]
  source = "shhnote_data"
  destination = "/data"

[http_service]
  internal_port = 3000
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  # SQLite on a volume means exactly one machine.
  min_machines_running = 1
  max_machines_running = 1

  [[http_service.checks]]
    interval = "30s"
    timeout = "5s"
    grace_period = "10s"
    method = "GET"
    path = "/api/v1/health"

[[vm]]
  size = "shared-cpu-1x"
  memory = "512mb"
