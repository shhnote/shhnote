# Copy to .env next to docker-compose.yml. Lines starting with SHH_ go to the server;
# the rest is read by Docker Compose only.

# --- Docker Compose -------------------------------------------------------------

# The site's domain; Caddy requests the certificate for it.
DOMAIN=secrets.example.com

# Which optional services to start. "caddy" for the bundled TLS proxy (the default);
# leave empty when you run your own proxy (see compose.own-proxy.yml); add "postgres"
# to run a database container.
COMPOSE_PROFILES=caddy

# --- shhnote ----------------------------------------------------------------------

SHH_ENV=production

# Public address of the site, scheme and host only.
SHH_URL=https://secrets.example.com

# Random, at least 32 characters. Signs admin sessions. `openssl rand -base64 48`
SHH_SECRET_KEY=

# Bootstrap credential for the admin panel, at least 32 characters. Only accepted
# until the first admin API key exists; remove it after that.
SHH_ADMIN_TOKEN=

# The compose network, so the proxy's X-Forwarded-For is honoured for rate limiting.
# Covers the bundled Caddy and a proxy on the host (it arrives from the gateway).
SHH_TRUSTED_PROXIES=172.28.0.0/16

# sqlite (default, stored on the shhnote-data volume) or postgres.
SHH_DB=sqlite
# With the postgres profile:
#SHH_DB=postgres
#SHH_PG_HOST=postgres
#SHH_PG_PORT=5432
#SHH_PG_DATABASE=shhnote
#SHH_PG_USERNAME=shhnote
#SHH_PG_PASSWORD=

# Blobs above SHH_INLINE_MAX: inline (refuse), local (the volume) or s3.
SHH_STORAGE=inline
#SHH_STORAGE=local
#SHH_LOCAL_MAX_TOTAL_BYTES=10737418240

# error, warn, info, debug or trace.
SHH_LOG_LEVEL=warn

# Languages to offer (default: all) and the landing language.
#SHH_LOCALES=en,de
#SHH_DEFAULT_LOCALE=en
